# Copy to config.env, replace placeholders, then load it through systemd.
# Never commit config.env.

# Root of the runtime tree. Use an absolute path.
PA_ROOT=/home/YOUR_USER/podcast-transcripts
PA_OUTDIR=/home/YOUR_USER/podcast-transcripts/out
PA_PORT=8787

# Required shared secret between Tasker and the Pi.
PA_TOKEN=replace-with-a-long-random-secret

# Local ASR
PA_MODEL=base.en
PA_LANG=en
PA_BEAM=1
PA_THREADS=4
PA_DEVICE=cpu
PA_COMPUTE=int8
PA_KEEP_AUDIO=1
PA_MAX_MB=800
PA_REQUIRE_COMPLETED=0

# AI ad classifier. Only transcript text is sent; audio stays local.
# Free models first; paid MiMo is last-resort availability fallback.
PA_CLEAN_PROVIDER=opencode-go
PA_CLEAN_MODEL=deepseek-v4.1-flash-free
PA_CLEAN_FALLBACK_MODELS=mimo-v2.6-flash-free,beam-free,mimo-v2.6-flash
PA_CLEAN_TIMEOUT=240
PA_CLEAN_RETRIES=1

# Local Hindsight
PA_HINDSIGHT_URL=http://127.0.0.1:8888
PA_HINDSIGHT_BANK=podcast-addict
PA_HINDSIGHT_TIMEOUT=30

# Failure notification through `hermes send`. Empty disables it.
PA_NOTIFY_TARGET=telegram
