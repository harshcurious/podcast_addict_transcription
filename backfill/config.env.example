# Copy to backfill/config.env (ignored by Git). backfill.py loads it automatically;
# variables already set in the environment take precedence.

# Runtime tree for the backfill. Kept apart from the Pi's ~/podcast-transcripts.
PA_ROOT=/Users/YOUR_USER/podcast-backfill

# Local speech recognition:
#   auto            Whisper large-v3-turbo on the Apple-silicon GPU (mlx-whisper), any language
#   whisper         the same, and fail if mlx-whisper is missing instead of using the CPU
#   faster-whisper  Whisper on the CPU
#   parakeet        Parakeet TDT v3 for its 25 European languages (Whisper for the rest):
#                   about 2x faster, a little less accurate, keeps "uh"/"um" (see README)
PA_ASR_BACKEND=auto
# Empty = mlx-community/parakeet-tdt-0.6b-v3
PA_PARAKEET_MODEL=
# Empty = mlx-community/whisper-large-v3-turbo (or large-v3-turbo for faster-whisper)
PA_WHISPER_MODEL=
# Empty = from the podcast's language in the backup; unknown languages go to Whisper
PA_LANG=
PA_MAX_MB=800

# AI ad classifier. Only transcript text is sent; audio stays on this Mac.
#   auto      openai when PA_CLEAN_API_URL is set, else Hermes if installed, else opencode
#   openai    any OpenAI-compatible server (local mlx_lm.server, OpenRouter, ...)
#   hermes    the Hermes CLI, as on the Pi
#   opencode  `opencode run` (your global opencode plugins and MCP servers are not loaded)
PA_CLEAN_BACKEND=auto

# --- openai backend: any OpenAI-compatible endpoint (see README for a local model) ---
#PA_CLEAN_API_URL=https://openrouter.ai/api/v1
#PA_CLEAN_API_KEY=
#PA_CLEAN_PROVIDER=openrouter
#PA_CLEAN_MODEL=provider/model-name
#PA_CLEAN_FALLBACK_MODELS=

# --- opencode / Hermes backends ---
PA_CLEAN_PROVIDER=opencode-go
# Use models your provider offers here: `opencode models | grep opencode-go/`
PA_CLEAN_MODEL=beam-free
PA_CLEAN_FALLBACK_MODELS=longcat-2.5-free,mimo-v2.6-flash
# Pin a specific opencode binary (default: the first `opencode` on PATH)
#PA_CLEAN_OPENCODE=/opt/homebrew/bin/opencode

PA_CLEAN_TIMEOUT=240
PA_CLEAN_RETRIES=1
# Stop cleaning for the rest of a run after this many Episodes fail in a row
PA_BACKFILL_MAX_CLEAN_FAILURES=5

# Hindsight that holds the Pi's podcast-addict bank, e.g. its Tailscale HTTPS name.
PA_HINDSIGHT_URL=https://YOUR-PI.YOUR-TAILNET.ts.net
PA_HINDSIGHT_BANK=podcast-addict
PA_HINDSIGHT_TIMEOUT=30
